# 운영 Compose 설정 예시. 실제 값은 같은 이름의 .env에 복사해 사용합니다(.env는 gitignore).
#
# 운영 기본 호스트 포트. 개발 기본값 8000과 분리한다.
LMS_WEB_PORT=8200
# 접속을 허용할 서버 주소. 기본은 로컬만(127.0.0.1). LAN/Tailscale 노출 시 0.0.0.0.
# 인증 없는 개인 모드이므로 공개 인터넷에 노출하지 않는다.
LMS_BIND_ADDRESS=0.0.0.0
# 브라우저 접속에 사용할 주소를 쉼표로 나열한다. 목록에 없는 Host는 400으로 거부된다.
LMS_ALLOWED_HOSTS=localhost,127.0.0.1
# 별도 프런트엔드 origin이 필요할 때만 지정한다. 무제한 CORS는 사용하지 않는다.
LMS_ALLOWED_ORIGINS=
# 서버 내부 Chrome 실행 설정(진단용). 기본 headless.
LMS_CHROME_HEADLESS=true
LMS_CHROME_PATH=/usr/bin/google-chrome
# 한도: 업로드 바이트, 최소 디스크 여유 바이트
LMS_MAX_UPLOAD_BYTES=4294967296
LMS_MIN_FREE_BYTES=2147483648
